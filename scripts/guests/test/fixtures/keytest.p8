pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- keytest: which buttons are down
function _draw()
 cls(1)
 rectfill(0,0,127,7,7)
 for i=0,5 do
  if btn(i) then rectfill(i*20,20,i*20+18,100,8+i) end
 end
end
