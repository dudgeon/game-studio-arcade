#!/bin/bash
# Drives the virtual cabinet's own screens from the mini over SSH, with no window (D144).
#
#   drive press KEY [MS]      tap a D82 key (default 80 ms)
#   drive hold KEY MS         hold it for MS, as hold-to-talk does
#   drive down KEY            press and keep held, until `drive up KEY`
#   drive up KEY
#   drive type TEXT           type any printable ASCII, US layout
#   drive screenshot FILE     save the 1024x768 screen as a PNG; checks its size
#   drive playtest            run the harness on the cabinet's carts, labelled virtual (D128)
#   drive apt-lock            print apt.lock with the versions the cabinet has now
#   drive status              services, screen mode, provisioned version
#   drive run FILE            run a local script on the cabinet as its admin
#   drive ssh [COMMAND]       a shell on the cabinet as its admin
#
# Keys: up down left right a b x y q e start enter esc star f1 f2 (D82). coin is f2, the COIN button (D205).
# ARCADE_HOST picks the cabinet (default arcade-virtual.local; D124). ARCADE_SSH_DIR picks the folder with its
# SSH key and known_hosts (default the virtual cabinet's); the Picade's card script makes its own (D251).
# ARCADE_SSH_PORT reaches a rehearsal VM's forwarded port (D337).
#
# The mini can lose the cabinet for a while (D156), so this waits it out for up to ARCADE_RIDE_S (default 300)
# seconds. Reads just repeat. Each key has an id, and a repeat with that id is pressed only if it wasn't already
# (D195), so a key lands exactly once. `drive ssh` and `drive run` don't repeat: their commands may not be safe to.
set -euo pipefail

HOST="${ARCADE_HOST:-arcade-virtual.local}"
VM_ROOT="${GSA_VM_DIR:-$HOME/game-studio-data/vm}"
SSH_DIR="${ARCADE_SSH_DIR:-$VM_ROOT/ssh}"
KEY="$SSH_DIR/${ARCADE_SSH_KEY_NAME:-arcade-virtual_ed25519}"
REPO="$(cd "$(dirname "$0")/../.." && pwd)"
# D416: the Picade is found by more than its name: picade-connect.sh tries arcade.local, the router's name for it,
# then the last address that worked. The host key is still checked under its name.
FIND=()
if [ "$HOST" = "$(sed -n 's/^PICADE_HOST=//p' "$REPO/scripts/cabinet-card/picade-ssh.sh")" ] && [ -z "${ARCADE_SSH_PORT:-}" ]; then
  FIND=(-o "ProxyCommand=$REPO/scripts/cabinet-card/picade-connect.sh %h %p")
fi

# IPv4 only: mDNS can offer an IPv6 address first that the mini can't route to.
# ARCADE_SSH_CONTROL reuses a connection flow.mjs holds open, so a key takes milliseconds.
# ServerAlive gives up on a dead connection after about 2 minutes, longer than a usual gap (D156).
# ARCADE_SSH_TIMEOUT_S, if set, is a hard limit on one attempt: an SSH call once sat stuck for 29 hours.
# A timed-out attempt exits 255, like any other SSH failure: the command may or may not have run.
cabinet() {
  local rc=0
  ${ARCADE_SSH_TIMEOUT_S:+perl -e 'alarm shift; exec @ARGV' "$ARCADE_SSH_TIMEOUT_S"} \
  ssh -4 -i "$KEY" -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=8 \
    -o ServerAliveInterval=15 -o ServerAliveCountMax=8 \
    -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$SSH_DIR/known_hosts" \
    ${FIND[@]+"${FIND[@]}"} \
    ${ARCADE_SSH_CONTROL:+-S "$ARCADE_SSH_CONTROL"} ${ARCADE_SSH_PORT:+-p "$ARCADE_SSH_PORT"} "cabinet@$HOST" "$@" || rc=$?
  [ "$rc" = 142 ] && return 255
  return "$rc"
}

keycode() {
  case "$1" in
    up) echo 103 ;; down) echo 108 ;; left) echo 105 ;; right) echo 106 ;;
    a) echo 44 ;; b) echo 45 ;; x) echo 46 ;; y) echo 47 ;;
    q) echo 16 ;; e) echo 18 ;;
    start|enter) echo 28 ;; esc|star) echo 1 ;;
    f1) echo 59 ;; f2|coin) echo 60 ;; backspace) echo 14 ;;
    *) echo "unknown key: $1 (up down left right a b x y q e start enter esc star f1 f2 coin backspace)" >&2; return 1 ;;
  esac
}

# A letter's Linux key code, US layout.
lettercode() {
  local row p
  for row in "16 qwertyuiop" "30 asdfghjkl" "44 zxcvbnm"; do
    case "${row#* }" in
      *"$1"*) p="${row#* }"; p="${p%%"$1"*}"; echo $((${row%% *} + ${#p})); return ;;
    esac
  done
}

# Printable ASCII as Linux key codes, CODE:SHIFT, US layout (the kiosk's default).
typecodes() {
  local LC_ALL=C text="$1" out="" i c k
  for ((i = 0; i < ${#text}; i++)); do
    c="${text:i:1}"
    case "$c" in
      [a-z]) k="$(lettercode "$c"):0" ;;
      [A-Z]) k="$(lettercode "$(printf '%s' "$c" | tr 'A-Z' 'a-z')"):1" ;;
      [1-9]) k="$((c + 1)):0" ;;
      0) k=11:0 ;;
      ' ') k=57:0 ;;
      '!') k=2:1 ;; '@') k=3:1 ;; '#') k=4:1 ;; '$') k=5:1 ;; '%') k=6:1 ;;
      '^') k=7:1 ;; '&') k=8:1 ;; '*') k=9:1 ;; '(') k=10:1 ;; ')') k=11:1 ;;
      -) k=12:0 ;; _) k=12:1 ;; =) k=13:0 ;; +) k=13:1 ;;
      '[') k=26:0 ;; '{') k=26:1 ;; ']') k=27:0 ;; '}') k=27:1 ;;
      ';') k=39:0 ;; :) k=39:1 ;; "'") k=40:0 ;; '"') k=40:1 ;;
      '`') k=41:0 ;; '~') k=41:1 ;; '\') k=43:0 ;; '|') k=43:1 ;;
      ,) k=51:0 ;; '<') k=51:1 ;; .) k=52:0 ;; '>') k=52:1 ;; /) k=53:0 ;; '?') k=53:1 ;;
      *) echo "can't type: '$c'" >&2; return 1 ;;
    esac
    out+=" $k"
  done
  echo "$out"
}

# SSH exits 255 when SSH itself failed: the command may or may not have run.
RIDE_S="${ARCADE_RIDE_S:-300}"
ride() {
  local until=$(( $(date +%s) + RIDE_S )) rc
  while true; do
    "$@" && return 0
    rc=$?
    [ "$rc" = 255 ] || return "$rc"
    if [ "$(date +%s)" -ge "$until" ]; then
      echo "drive: no answer from the cabinet at $HOST for $RIDE_S s" >&2
      return 255
    fi
    sleep 3
  done
}

# Sends a key command, exactly once: the daemon ignores an id it has already done. Each attempt is limited to
# 60 s plus however long the keys take, so a stuck one is cut off and asked again by id.
keys() {
  local id extra=0
  id="$(uuidgen | tr -d -)"
  case "$1" in
    tap) extra=$(( ${2:-0} / 1000 )) ;;
    seq) extra=$(( ($# - 1) / 10 )) ;;
  esac
  ARCADE_SSH_TIMEOUT_S=$(( 60 + extra )) ride cabinet sudo arcade-keyd "id=$id" "$@"
}

cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
  press) code="$(keycode "$1")"; keys tap "${2:-80}" "$code" ;;
  hold) code="$(keycode "$1")"; keys tap "$2" "$code" ;;
  down) code="$(keycode "$1")"; keys down "$code" ;;
  up) code="$(keycode "$1")"; keys up "$code" ;;
  type)
    codes="$(typecodes "$1")"
    # shellcheck disable=SC2086  # one argument per key
    [ -z "$codes" ] || keys seq $codes
    ;;
  screenshot)
    out="$1"
    grab() { ARCADE_SSH_TIMEOUT_S=60 cabinet sudo arcade-screenshot > "$out.tmp"; }
    ride grab
    size="$(file -b "$out.tmp")"
    case "$size" in
      *"PNG image data, 1024 x 768"*) mv "$out.tmp" "$out"; echo "$out" ;;
      *) echo "not a 1024x768 PNG: $size (kept as $out.tmp)" >&2; exit 1 ;;
    esac
    ;;
  playtest) cabinet sudo -u arcade node /opt/arcade/current/cabinet/vm/guest/playtest-virtual.mjs ;;
  apt-lock)
    names="$(grep -vE '^[[:space:]]*(#|$)' "$REPO/cabinet/provision/apt.lock" | cut -d= -f1 | tr '\n' ' ')"
    # shellcheck disable=SC2086
    cabinet "dpkg-query -W -f='\${Package}=\${Version}\n' $names"
    ;;
  status)
    cabinet 'cat /etc/hostname; cat /etc/arcade/provisioned-version; cat /etc/arcade/provisioned-commit 2>/dev/null; uname -r; systemctl is-active arcade-launcher arcade-kiosk arcade-keyd nftables avahi-daemon; sudo runuser -u arcade -- env XDG_RUNTIME_DIR=/run/user/$(id -u arcade) WAYLAND_DISPLAY=wayland-0 wlr-randr'
    ;;
  run) cabinet bash -s < "$1" ;;
  ssh) cabinet "$@" ;;
  *) sed -n '2,15p' "$0" >&2; exit 2 ;;
esac
