#!/bin/bash
# The cabinet's speaker volume (D420). The X HAT's DAC has no volume of its own: the level is the softvol
# control "PCM" on card sndrpihifiberry (D253), a percentage, kept across restarts by alsactl store (D366).
#
#   arcade-volume get          {"speaker": true, "percent": 30, "cap": 60}
#   arcade-volume default      set the quiet default and store it, unless a level is already stored.
#                              A stored level is someone's choice (the Manager's slider, the cabinet's controls),
#                              so every later boot and every update leaves it alone.
#   arcade-volume set N        0 to 100: the grown-up's range
#   arcade-volume up | down    one step, for the cabinet's own controls: never above the cap, so a kid can
#                              turn it down but can't blast it. A level already above the cap only comes down.
#
# Run as root (alsactl store writes /var/lib/alsa). The ARCADE_* variables are for its test.
set -uo pipefail
CARD="${ARCADE_SOUND_CARD:-sndrpihifiberry}"
STATE="${ARCADE_ALSA_STATE:-/var/lib/alsa/asound.state}"
DEFAULT="${ARCADE_VOLUME_DEFAULT:-30}"
CAP="${ARCADE_VOLUME_CAP:-60}"
STEP="${ARCADE_VOLUME_STEP:-10}"
ALSACTL="${ARCADE_ALSACTL:-/usr/sbin/alsactl}"

percent() { amixer -c "$CARD" sget PCM 2>/dev/null | sed -n 's/.*\[\([0-9]*\)%\].*/\1/p' | head -1; }
has_card() { aplay -l 2>/dev/null | grep -q "$CARD"; }

# The softvol control appears once something has played through it; a moment of silence makes it.
ensure_control() {
  amixer -c "$CARD" sget PCM >/dev/null 2>&1 && return 0
  timeout 2 aplay -q -D default -f S16_LE -r 44100 -c 2 -d 1 /dev/zero >/dev/null 2>&1 || true
  amixer -c "$CARD" sget PCM >/dev/null 2>&1
}

# Is a level for this card's PCM control in the stored state? Only inside this card's own block: the mic is a
# sound card too. alsactl writes the softvol control as plain "name PCM" (seen on the Picade, 2026-11-14).
stored() {
  [ -f "$STATE" ] || return 1
  awk -v card="state.$CARD" '
    /^state\./ { mine = ($1 == card) }
    mine && $1 == "name" && ($2 == "PCM" || $2 == "\047PCM\047" || $0 ~ /name \047PCM Playback Volume\047/) { found = 1 }
    END { exit found ? 0 : 1 }' "$STATE"
}

apply() {
  ensure_control || { echo '{"error": "the speaker has no volume control yet"}'; return 1; }
  amixer -q -c "$CARD" sset PCM "$1%" || { echo '{"error": "amixer refused"}'; return 1; }
  "$ALSACTL" store "$CARD" 2>/dev/null || "$ALSACTL" store 2>/dev/null || true
}

report() {
  local p
  p="$(percent)"
  echo "{\"speaker\": true, \"percent\": ${p:-null}, \"cap\": $CAP${1:-}}"
}

action="${1:-get}"
if ! has_card; then
  echo '{"speaker": false}'
  exit 0
fi
case "$action" in
  get) report ;;
  default)
    if stored; then
      report ', "kept": true'
      exit 0
    fi
    apply "$DEFAULT" || exit 1
    report
    ;;
  set)
    n="${2:-}"
    case "$n" in '' | *[!0-9]*) echo '{"error": "volume is a whole number, 0 to 100"}'; exit 2 ;; esac
    [ "$n" -le 100 ] || { echo '{"error": "volume is 0 to 100"}'; exit 2; }
    apply "$n" || exit 1
    report
    ;;
  up | down)
    ensure_control || { echo '{"error": "the speaker has no volume control yet"}'; exit 1; }
    now="$(percent)"
    now="${now:-$DEFAULT}"
    if [ "$action" = up ]; then
      n=$(((now / STEP + 1) * STEP))
      [ "$n" -le "$CAP" ] || n="$CAP"
      [ "$n" -ge "$now" ] || n="$now" # already above the cap (a grown-up's choice): up does nothing
    else
      n=$(((now + STEP - 1) / STEP * STEP - STEP))
      [ "$n" -ge 0 ] || n=0
    fi
    if [ "$n" != "$now" ]; then apply "$n" || exit 1; fi
    report
    ;;
  *)
    echo '{"error": "unknown action"}'
    exit 2
    ;;
esac
