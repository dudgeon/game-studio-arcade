[Unit]
Description=Arcade kiosk (cage + Chromium) on the cabinet's screen
After=systemd-user-sessions.service arcade-launcher.service
Wants=arcade-launcher.service
Conflicts=getty@tty1.service

[Service]
User=arcade
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
EnvironmentFile=/etc/arcade/kiosk.env
Environment=XDG_SESSION_TYPE=wayland
ExecStartPre=/bin/bash -c 'for i in {1..30}; do (exec 3<>/dev/tcp/127.0.0.1/8330) 2>/dev/null && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/bin/cage -s -- /usr/local/bin/arcade-session
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
