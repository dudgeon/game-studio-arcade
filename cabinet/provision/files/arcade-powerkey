#!/usr/bin/env python3
"""The cabinet's power button (D372): a tap does nothing, holding it switches the cabinet off cleanly.

Geoff's choice (2026-11-14): "Tap ignored, hold to switch off". The Picade's overlay reports the button as KEY_POWER
on its gpio_keys device. systemd-logind can't do this itself: its long press is fixed at 5 s (LONG_PRESS_DURATION in
logind-button.c, systemd 257), past the X HAT's own 3 s hard cut. So logind ignores the key
(logind.conf.d/arcade-power.conf) and this watches every input device that has KEY_POWER, and starts a clean
shutdown the moment the button has been held for HOLD seconds, without waiting for it to be let go.
A tap that switches the cabinet on is the HAT's own and never reaches here.

  /etc/arcade/power-button   "hold=2" (seconds, 0.5 to 2.8). Absent: 2.
  ARCADE_POWER_ACTION        what to run when held (tests); default systemctl poweroff
"""
import glob
import os
import select
import struct
import subprocess
import sys
import time

KEY_POWER = 116
EV_KEY = 1
EVENT = struct.Struct("llHHi")  # struct input_event on 64-bit Linux: timeval, type, code, value
SETTING = os.environ.get("ARCADE_POWER_SETTING", "/etc/arcade/power-button")
ACTION = os.environ.get("ARCADE_POWER_ACTION", "systemctl poweroff").split()


def log(msg):
    print(f"arcade-powerkey: {msg}", flush=True)


def hold_seconds():
    try:
        for line in open(SETTING):
            k, _, v = line.strip().partition("=")
            if k == "hold":
                return min(2.8, max(0.5, float(v)))
    except (OSError, ValueError):
        pass
    return 2.0


def has_power_key(event_path):
    """From sysfs: the device's key bitmap, as hex words, most significant first."""
    name = os.path.basename(event_path)
    try:
        words = open(f"/sys/class/input/{name}/device/capabilities/key").read().split()
    except OSError:
        return False
    bits = 0
    for w in words:
        bits = (bits << 64) | int(w, 16)
    return bool(bits >> KEY_POWER & 1)


def device_name(event_path):
    try:
        return open(f"/sys/class/input/{os.path.basename(event_path)}/device/name").read().strip()
    except OSError:
        return "?"


def main():
    hold = hold_seconds()
    log(f"a tap is ignored; holding {hold:g} s switches the cabinet off")
    open_devs = {}  # fd -> path
    pressed_at = None
    last_scan = 0.0
    while True:
        now = time.monotonic()
        if now - last_scan > 2:
            last_scan = now
            known = set(open_devs.values())
            for p in sorted(glob.glob("/dev/input/event*")):
                if p not in known and has_power_key(p):
                    try:
                        open_devs[os.open(p, os.O_RDONLY | os.O_NONBLOCK)] = p
                        log(f"watching {p} ({device_name(p)})")
                    except OSError as e:
                        log(f"can't open {p}: {e}")
        timeout = 0.5
        if pressed_at is not None:
            timeout = max(0.0, min(timeout, pressed_at + hold - time.monotonic()))
        ready, _, _ = select.select(list(open_devs), [], [], timeout)
        for fd in ready:
            try:
                data = os.read(fd, EVENT.size * 64)
            except OSError:
                log(f"lost {open_devs[fd]}")
                os.close(fd)
                del open_devs[fd]
                continue
            for i in range(0, len(data) - EVENT.size + 1, EVENT.size):
                _, _, typ, code, value = EVENT.unpack_from(data, i)
                if typ != EV_KEY or code != KEY_POWER:
                    continue
                if value == 1:
                    pressed_at = time.monotonic()
                elif value == 0 and pressed_at is not None:
                    log(f"tap ({time.monotonic() - pressed_at:.1f} s): ignored")
                    pressed_at = None
        if pressed_at is not None and time.monotonic() - pressed_at >= hold:
            log(f"held {hold:g} s: switching off")
            pressed_at = None
            subprocess.run(ACTION, check=False)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
