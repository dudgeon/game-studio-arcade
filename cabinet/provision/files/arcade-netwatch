#!/bin/bash
# The virtual cabinet's own record of its network paths (D242), into the journal, which is kept on disk here.
# Every round, for each interface with an IPv4 address:
#   router  ping to the default gateway, on the interface that has it
#   mini    an ARP probe to the first of the mini's addresses that's on that interface's link
# ARP isn't a connection, so the probe stays inside D124's rule (no new connections to the mini).
# It prints a CHANGE line when any path changes and a COUNT line every COUNT_EVERY rounds.
# On the bridged interface (the one with the default route) it also announces itself (gratuitous ARP)
# every round, and when the mini's path there is down for a second round in a row it forgets the mini's
# ARP entry and announces three more times. That's a nudge, logged as such, so the record shows whether
# it helps. Plain bash 3 so it's tested on the mini as it runs here.
set -u
INTERVAL="${NETWATCH_INTERVAL:-15}"
ROUNDS="${NETWATCH_ROUNDS:-0}"            # 0 runs for ever; tests set a count
COUNT_EVERY="${NETWATCH_COUNT_EVERY:-40}" # 40 rounds of 15 s: every 10 minutes
MINI_ADDRS="${NETWATCH_MINI_ADDRS:-/etc/arcade/mini-addrs}"
# The shared network's gateway is the mini (D241); macOS gives it this address unless told otherwise.
LINK_GATEWAY="${NETWATCH_LINK_GATEWAY:-192.168.64.1}"

say() { echo "netwatch $*"; }

mini_candidates() {
  { [ -r "$MINI_ADDRS" ] && grep -E '^[0-9]+(\.[0-9]+){3}$' "$MINI_ADDRS"; echo "$LINK_GATEWAY"; } | sort -u
}

# "dev ip" for each interface with a global IPv4 address.
interfaces() { ip -o -4 addr show scope global | awk '{split($4, a, "/"); print $2, a[1]}'; }

# "dev gateway" of the default route.
default_route() {
  ip -4 route show default | awk '{for (i = 1; i < NF; i++) { if ($i == "via") g = $(i + 1); if ($i == "dev") d = $(i + 1) } print d, g; exit}'
}

# Is ADDR on DEV's own link, with no gateway between?
on_link() {
  local r
  r="$(ip -4 route get "$2" 2>/dev/null | head -1)"
  case "$r" in *" via "*) return 1 ;; *" dev $1 "*) return 0 ;; *) return 1 ;; esac
}

# Counters live in plain variables named after the path: up_eth0_mini and so on.
var() { echo "${1}_${2//[^A-Za-z0-9]/_}"; }
get() { local v; v="$(var "$1" "$2")"; echo "${!v:-0}"; }
put() { printf -v "$(var "$1" "$2")" '%s' "$3"; }

keys=""
round=0
prev=""
while [ "$ROUNDS" = 0 ] || [ "$round" -lt "$ROUNDS" ]; do
  round=$((round + 1))
  bdev=""; gw=""
  read -r bdev gw < <(default_route)
  now=""
  while read -r dev addr; do
    [ -n "$dev" ] || continue
    if [ "$dev" = "$bdev" ]; then
      arping -q -U -c 1 -I "$dev" "$addr" >/dev/null 2>&1 || true
      s=DOWN
      [ -n "$gw" ] && ping -n -q -c 1 -W 2 -I "$dev" "$gw" >/dev/null 2>&1 && s=up
      now="$now $dev.router=$s"
    fi
    for m in $(mini_candidates); do
      on_link "$dev" "$m" || continue
      key="$dev.mini"
      if arping -q -c 1 -w 2 -I "$dev" "$m" >/dev/null 2>&1; then s=up; put down "$key" 0
      else
        s=DOWN; put down "$key" $(( $(get down "$key") + 1 ))
        if [ "$dev" = "$bdev" ] && [ "$(get down "$key")" = 2 ]; then
          ip neigh flush to "$m" dev "$dev" >/dev/null 2>&1 || true
          for _ in 1 2 3; do arping -q -U -c 1 -I "$dev" "$addr" >/dev/null 2>&1 || true; done
          say "NUDGE $dev: forgot $m's ARP entry and announced $addr three times"
        fi
      fi
      now="$now $key=$s"
      break
    done
  done < <(interfaces)
  for kv in $now; do
    k="${kv%%=*}"
    case " $keys " in *" $k "*) ;; *) keys="$keys $k" ;; esac
    put seen "$k" $(( $(get seen "$k") + 1 ))
    [ "${kv#*=}" = up ] && put up "$k" $(( $(get up "$k") + 1 ))
  done
  [ "$now" = "$prev" ] || say "CHANGE$now"
  prev="$now"
  if [ $((round % COUNT_EVERY)) = 0 ]; then
    line=""
    for k in $keys; do line="$line $k=$(get up "$k")/$(get seen "$k")"; done
    say "COUNT$line"
  fi
  if [ "$ROUNDS" = 0 ] || [ "$round" -lt "$ROUNDS" ]; then sleep "$INTERVAL"; fi
done
