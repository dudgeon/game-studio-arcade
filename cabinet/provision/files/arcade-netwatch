#!/bin/bash
# The virtual cabinet's own record of its network paths (D242, D245), into the journal, which is kept on disk here.
# Every round, for each interface with an IPv4 address:
#   router  ping to the default gateway, on the interface that has it
#   subnet  whether the interface's own subnet route is there (D245: a lost one sends the LAN via the router)
#   mini    an ARP probe to the first of the mini's addresses inside that interface's subnet
# ARP isn't a connection, so the probe stays inside D124's rule (no new connections to the mini).
# It only watches: no announcements (D245 found they may provoke a false address conflict).
# It prints a CHANGE line when anything changes and a COUNT line every COUNT_EVERY rounds.
# Plain bash 3, so it's tested on the mini as it runs here.
set -u
INTERVAL="${NETWATCH_INTERVAL:-15}"
ROUNDS="${NETWATCH_ROUNDS:-0}"            # 0 runs for ever; tests set a count
COUNT_EVERY="${NETWATCH_COUNT_EVERY:-40}" # 40 rounds of 15 s: every 10 minutes
MINI_ADDRS="${NETWATCH_MINI_ADDRS:-/etc/arcade/mini-addrs}"
# The shared network's gateway is the mini (D241); macOS gives it this address unless told otherwise.
LINK_GATEWAY="${NETWATCH_LINK_GATEWAY:-192.168.64.1}"

say() { echo "netwatch $*"; }

mini_candidates() {
  { [ -r "$MINI_ADDRS" ] && grep -E '^[0-9]+(\.[0-9]+){3}$' "$MINI_ADDRS"; echo "$LINK_GATEWAY"; } | sort -u
}

# "dev ip/prefix" for each interface with a global IPv4 address.
interfaces() { ip -o -4 addr show scope global | awk '{print $2, $4}'; }

# "dev gateway" of the default route.
default_route() {
  ip -4 route show default | awk '{for (i = 1; i < NF; i++) { if ($i == "via") g = $(i + 1); if ($i == "dev") d = $(i + 1) } print d, g; exit}'
}

to_int() { local IFS=.; set -- $1; echo $(( ($1 << 24) + ($2 << 16) + ($3 << 8) + $4 )); }
to_ip() { echo "$(( ($1 >> 24) & 255 )).$(( ($1 >> 16) & 255 )).$(( ($1 >> 8) & 255 )).$(( $1 & 255 ))"; }
mask_of() { [ "$1" = 0 ] && echo 0 || echo $(( (0xffffffff << (32 - $1)) & 0xffffffff )); }

# Is ADDR inside CIDR (a.b.c.d/n)? By the interface's own address, not the routes, which D245 saw go missing.
in_subnet() {
  local m; m="$(mask_of "${2#*/}")"
  [ $(( $(to_int "$1") & m )) = $(( $(to_int "${2%/*}") & m )) ]
}

# The subnet's route, as "a.b.c.0/n dev DEV", is in the main table.
has_subnet_route() {
  local n m; m="$(mask_of "${2#*/}")"
  n="$(to_ip $(( $(to_int "${2%/*}") & m )))/${2#*/}"
  ip -4 route show table main | grep -q "^$n dev $1 "
}

# Counters live in plain variables named after the path: up_eth0_mini and so on.
var() { echo "${1}_${2//[^A-Za-z0-9]/_}"; }
get() { local v; v="$(var "$1" "$2")"; echo "${!v:-0}"; }
put() { printf -v "$(var "$1" "$2")" '%s' "$3"; }

keys=""
round=0
prev=""
while [ "$ROUNDS" = 0 ] || [ "$round" -lt "$ROUNDS" ]; do
  round=$((round + 1))
  bdev=""; gw=""
  read -r bdev gw < <(default_route)
  now=""
  while read -r dev cidr; do
    [ -n "$dev" ] || continue
    if [ "$dev" = "$bdev" ]; then
      s=DOWN
      [ -n "$gw" ] && ping -n -q -c 1 -W 2 -I "$dev" "$gw" >/dev/null 2>&1 && s=up
      now="$now $dev.router=$s"
    fi
    s=DOWN; has_subnet_route "$dev" "$cidr" && s=up
    now="$now $dev.subnet=$s"
    for m in $(mini_candidates); do
      in_subnet "$m" "$cidr" || continue
      s=DOWN; arping -q -c 1 -w 2 -I "$dev" "$m" >/dev/null 2>&1 && s=up
      now="$now $dev.mini=$s"
      break
    done
  done < <(interfaces)
  for kv in $now; do
    k="${kv%%=*}"
    case " $keys " in *" $k "*) ;; *) keys="$keys $k" ;; esac
    put seen "$k" $(( $(get seen "$k") + 1 ))
    [ "${kv#*=}" = up ] && put up "$k" $(( $(get up "$k") + 1 ))
  done
  [ "$now" = "$prev" ] || say "CHANGE$now"
  prev="$now"
  if [ $((round % COUNT_EVERY)) = 0 ]; then
    line=""
    for k in $keys; do line="$line $k=$(get up "$k")/$(get seen "$k")"; done
    say "COUNT$line"
  fi
  if [ "$ROUNDS" = 0 ] || [ "$round" -lt "$ROUNDS" ]; then sleep "$INTERVAL"; fi
done
