[Unit]
Description=Record the virtual cabinet's network paths (D242)
# Not network-online.target: Pi OS enables networkd's wait-online too, and with NetworkManager running the
# network it waits 2 minutes and fails on every boot. The record should start at once, gaps and all.
After=NetworkManager.service

[Service]
ExecStart=/usr/local/bin/arcade-netwatch
Restart=always
RestartSec=10
Nice=10

[Install]
WantedBy=multi-user.target
