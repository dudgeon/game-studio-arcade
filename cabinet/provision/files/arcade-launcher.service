[Unit]
Description=Cabinet service (launcher and Studio)
After=local-fs.target

[Service]
User=arcade
Environment=GSA_DATA_DIR=/var/lib/arcade
Environment=HOME=/home/arcade
EnvironmentFile=/etc/arcade/service.env
ExecStart=/usr/local/bin/node /opt/arcade/current/cabinet/service/bin/cabinet-service.js --data /var/lib/arcade $ARCADE_SERVICE_ARGS
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
