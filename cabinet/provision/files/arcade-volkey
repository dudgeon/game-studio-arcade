#!/usr/bin/env python3
"""The volume at the cabinet's own controls (D421): hold ENT and press a pink button.

Geoff's choice (2026-11-14): "enter plus pink buttons". While ENT (F1) is held, pink 5 (Q) is quieter and pink 6
(E) is louder, one step each press, through arcade-volume (steps of 10, never above its cap, D420). The pinks
alone stay spare, and ENT held alone does nothing here. With COIN (F2) held as well this does nothing: ENT and
COIN together belong to the Wi-Fi screen.

It watches the input devices, not the browser, so it works in every game: a guest game holds the keyboard focus
in its own frame, where the launcher sees no keys. After each change it writes the new level to SHOW, which the
cabinet service passes to the launcher for the bar on screen.

  ARCADE_VOLUME_CMD       the tool to run (tests); default /usr/local/bin/arcade-volume
  ARCADE_VOLUME_SHOW      where the level is written; default /run/arcade-volume/level.json
  ARCADE_VOLKEY_DEVICES   input files to read instead of scanning /dev/input (tests)
"""
import glob
import json
import os
import select
import struct
import subprocess
import sys
import time

KEY_Q, KEY_E, KEY_F1, KEY_F2 = 16, 18, 59, 60
QUIETER, LOUDER, HOLD, COIN = KEY_Q, KEY_E, KEY_F1, KEY_F2
EV_KEY = 1
EVENT = struct.Struct("llHHi")  # struct input_event on 64-bit Linux: timeval, type, code, value
CMD = os.environ.get("ARCADE_VOLUME_CMD", "/usr/local/bin/arcade-volume")
SHOW = os.environ.get("ARCADE_VOLUME_SHOW", "/run/arcade-volume/level.json")
FIXED = os.environ.get("ARCADE_VOLKEY_DEVICES")


def log(msg):
    print(f"arcade-volkey: {msg}", flush=True)


def has_keys(event_path):
    """From sysfs: the device's key bitmap, as hex words, most significant first."""
    name = os.path.basename(event_path)
    try:
        words = open(f"/sys/class/input/{name}/device/capabilities/key").read().split()
    except OSError:
        return False
    bits = 0
    for w in words:
        bits = (bits << 64) | int(w, 16)
    return all(bits >> k & 1 for k in (HOLD, QUIETER, LOUDER))


def candidates():
    if FIXED:
        return FIXED.split(":")
    return [p for p in sorted(glob.glob("/dev/input/event*")) if has_keys(p)]


def change(direction):
    try:
        r = subprocess.run([CMD, direction], capture_output=True, text=True, timeout=5, check=False)
        level = json.loads(r.stdout.strip().splitlines()[-1])
    except (OSError, ValueError, IndexError, subprocess.TimeoutExpired) as e:
        log(f"{direction}: {e}")
        return
    if level.get("percent") is None:
        log(f"{direction}: {level}")
        return
    log(f"{direction}: {level['percent']}%")
    try:
        os.makedirs(os.path.dirname(SHOW), mode=0o755, exist_ok=True)
        with open(SHOW + ".new", "w") as f:
            json.dump({"percent": level["percent"], "cap": level.get("cap", 100), "at": time.time()}, f)
        os.chmod(SHOW + ".new", 0o644)
        os.replace(SHOW + ".new", SHOW)
    except OSError as e:
        log(f"can't write {SHOW}: {e}")


def main():
    log("hold ENT and press a pink button: 5 is quieter, 6 is louder")
    open_devs = {}  # fd -> path
    gone = set()  # test files that reached their end
    held = set()
    last_scan = None
    while True:
        now = time.monotonic()
        if last_scan is None or now - last_scan > 2:
            last_scan = now
            known = set(open_devs.values()) | gone
            for p in candidates():
                if p in known:
                    continue
                try:
                    open_devs[os.open(p, os.O_RDONLY | os.O_NONBLOCK)] = p
                    log(f"watching {p}")
                except OSError as e:
                    log(f"can't open {p}: {e}")
        ready, _, _ = select.select(list(open_devs), [], [], 0.5)
        for fd in ready:
            try:
                data = os.read(fd, EVENT.size * 64)
            except BlockingIOError:
                continue
            except OSError:
                data = b""
            if not data:
                log(f"lost {open_devs[fd]}")
                if FIXED:
                    gone.add(open_devs[fd])
                os.close(fd)
                del open_devs[fd]
                held.clear()  # a key held on a device that went away is no longer held
                continue
            for i in range(0, len(data) - EVENT.size + 1, EVENT.size):
                _, _, typ, code, value = EVENT.unpack_from(data, i)
                if typ != EV_KEY or code not in (HOLD, COIN, QUIETER, LOUDER):
                    continue
                if value == 0:
                    held.discard(code)
                elif value == 1:  # 2 is the keyboard's own repeat: one press is one step
                    held.add(code)
                    if code in (QUIETER, LOUDER) and HOLD in held and COIN not in held:
                        change("down" if code == QUIETER else "up")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
