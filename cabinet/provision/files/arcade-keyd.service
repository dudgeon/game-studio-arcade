[Unit]
Description=Arcade driver keyboard (uinput; the virtual cabinet, and the Picade only if asked: D144, D258)
After=systemd-modules-load.service
Before=arcade-kiosk.service

[Service]
ExecStart=/usr/local/bin/arcade-keyd serve
Restart=always
RestartSec=1
RuntimeDirectory=arcade

[Install]
WantedBy=multi-user.target
