[Unit]
Description=Arcade driver keyboard (uinput; always on the virtual cabinet, D144; on the Picade only when switched on, D287)
After=systemd-modules-load.service
Before=arcade-kiosk.service

[Service]
ExecStart=/usr/local/bin/arcade-keyd serve
Restart=always
RestartSec=1
RuntimeDirectory=arcade

[Install]
WantedBy=multi-user.target
