# L1: the pot can't cover a new game, but a change still fits. Then the change, from a starter (G5, R3).
#seed seeds/pot-low.json
#! --examples
wait S1
shot S1-pot-low
press a
wait M1
press a
wait L1
shot L1-pot-almost-empty
press down
press a
wait A1
shot A1-who-used-the-coins
press esc
wait L1
press up
press a
wait S1
press down
press a
wait G0
press a
wait play
sleep 600
press esc
wait G5
press up
press up
press a
wait R1
press a
wait R3
shot R3-a-change-still-fits
