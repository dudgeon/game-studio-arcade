# Copy to .env (gitignored). Non-secret settings only: never put credentials here,
# and never set ANTHROPIC_API_KEY (it silently overrides the ant CLI profile, D16).

# ant CLI / SDK profile the mini signs in with (D16).
GSA_PROFILE=game-studio-arcade
# The game-studio-arcade workspace id (wrkspc_...), used by scripts/setup-anthropic-auth.sh.
GSA_WORKSPACE_ID=

# Where Phase 0 logs and the dev cart library live (D14).
GSA_DATA_DIR=~/game-studio-data

# Port for the runtime dev server (runtime/dev-server.js).
GSA_DEV_PORT=8320
