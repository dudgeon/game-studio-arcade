# cx-audit: the guest game teti and Geoff's version: picker, play, pause, the spare keys, leave.
#seed family.json
wait S1
# Guests join the shelf once the publish gate has checked them (D310).
sleep 12000
press down
press down
press down
press down
press down
press down
shot shelf-teti-lit
# Stick right on a guest: no card.
press right
shot shelf-teti-stick-right
press a
wait G0
shot teti-G0
press a
wait play
sleep 4000
shot teti-picker
press down
press down
press down
shot teti-picker-zen
press a
sleep 4500
shot teti-zen-playing
hold left 300
press a
press up
sleep 600
press x
press y
shot teti-after-moves
# START pauses.
press start
sleep 500
shot teti-paused
press a
sleep 800
# ENT, COIN and the pinks in a game.
press f1
press f2
press q
press e
sleep 500
shot teti-after-ENT-COIN-pinks
# ENT held with a pink: the volume chord.
down f1
press q
press e
up f1
sleep 500
shot teti-after-volume-chord
press start
sleep 500
press down
press down
press a
sleep 800
shot teti-pick-another-game
press esc
wait G6
shot teti-G6-done
press esc
wait S1
shot shelf-back-on-teti
press down
press a
wait G0
shot teti-geoff-G0
press a
wait play
sleep 4000
press a
sleep 5000
shot teti-geoff-marathon
# Drop pieces until it tops out.
press up
press up
press up
press up
press up
press up
press up
press up
press up
press up
press up
press up
press up
press up
press up
press up
sleep 2500
shot teti-geoff-game-over
press esc
wait G6
shot teti-geoff-G6-score
press up
press a
wait play
sleep 3000
shot teti-geoff-play-again
press esc
wait G6
press a
wait S1
